        "sendBody": true,
        "contentType": "raw",
        "body": "{\n  \"to\": \"YOUR_LINE_USER_ID\",\n  \"messages\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"Hello from n8n! 這是你的第一則 LINE 推播通知。\"\n    }\n  ]\n}"
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          { "node": "LINE Push Message", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
