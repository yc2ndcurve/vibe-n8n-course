      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "id": "http-line-001",
      "name": "LINE Push Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300],
      "parameters": {
        "url": "https://api.line.me/v2/bot/message/push",
