{
  "name": "Ch2 - Webhook 接收資料",
  "nodes": [
    {
      "id": "webhook-001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "demo-webhook-ch2",
      "parameters": {
        "path": "ch2-demo",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      }
    },
    {
      "id": "set-002",
      "name": "格式化回應",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [470, 300],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "field-1",
              "name": "received_name",
              "value": "={{ $json.body.name }}",
              "type": "string"
            },
            {
              "id": "field-2",
              "name": "received_email",
              "value": "={{ $json.body.email }}",
              "type": "string"
            },
            {
              "id": "field-3",
              "name": "received_at",
              "value": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "格式化回應",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
